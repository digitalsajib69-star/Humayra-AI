<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Comprehensive AppOps attribution tags for GMS, Speech Services, Webviews, and general platforms -->
    <attribution
        android:tag="attributionTag"
        android:label="@string/app_name" />
    <attribution
        android:tag="speech"
        android:label="@string/app_name" />
    <attribution
        android:tag="text_to_speech"
        android:label="@string/app_name" />
    <attribution
        android:tag="speech_recognition"
        android:label="@string/app_name" />
    <attribution
        android:tag="location"
        android:label="@string/app_name" />
    <attribution
        android:tag="webview"
        android:label="@string/app_name" />
    <attribution
        android:tag="play-services-maps"
        android:label="@string/app_name" />
    <attribution
        android:tag="play-services-location"
        android:label="@string/app_name" />
    <attribution
        android:tag="play-services-speech"
        android:label="@string/app_name" />
    <attribution
        android:tag="play-services-auth"
        android:label="@string/app_name" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
